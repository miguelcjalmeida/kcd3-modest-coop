<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SyntheticPeer</RootNamespace>
    <!-- Shares agent/version.txt with ItemSwapAgent - same toolkit, same version. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\version.txt').Trim())</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ItemSwap.Net\ItemSwap.Net.csproj" />
  </ItemGroup>

</Project>
